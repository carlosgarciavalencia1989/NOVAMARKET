%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 257ba41e073b10a4cbe266f99f49a89e, type: 3}
  m_Name: Dialogue_1.1_Andres
  m_EditorClassIdentifier: NovaMarket.Runtime::NovaMarket.Data.DialogueData
  id: 1.1-andres
  displayName: "Nivel 1.1 \xB7 Andr\xE9s"
  description: "Andr\xE9s en el nivel 1.1 Reunir la historia (mentor, modo guiado)."
  character: {fileID: 11400000, guid: 6e25b6e5246067341937c05527caa91b, type: 2}
  levelId: 1.1
  roleId: planeador
  sectorId: 
  lines:
  - key: intro
    order: 1
    mood: 0
    text: "Te doy la bienvenida al equipo de planeaci\xF3n. Todo pron\xF3stico empieza
      por la historia de ventas: el modelo solo aprende lo que est\xE1 en ella. Hoy
      la vas a reunir."
  - key: intro
    order: 3
    mood: 0
    text: "Arma la tabla como en el Atlas: un SKU por fila y un mes por columna.
      Con 24 meses o m\xE1s ya se ven dos temporadas completas."
  - key: aviso-proyeccion
    order: 1
    mood: 2
    text: "Ojo con la columna que termina en \xAB(proy.)\xBB: no es venta, es un
      c\xE1lculo del ERP para el mes que va corriendo (el promedio de los \xFAltimos
      meses). Si la dejas, mezclas un pron\xF3stico con la historia y todo lo que
      calcules despu\xE9s sale mal. Descarga otra vez sin \xABIncluir proyecci\xF3n\xBB
      o borra esa columna."
  - key: pista-periodos
    order: 1
    mood: 0
    text: 'En la fila 1, encima de los meses, numera los periodos: escribe 1 en C1
      y 2 en D1, selecciona las dos celdas y arrastra el cuadrito de la esquina hasta
      AT1. La hoja sigue contando sola hasta 44.'
  - key: pista-totales
    order: 1
    mood: 0
    text: "En AW3 te dej\xE9 =SUMA(AI3:AT3), que suma los \xFAltimos 12 meses (sep-25
      a ago-26) del primer SKU. Arrastra el cuadrito de la esquina de AW3 hacia abajo
      y la f\xF3rmula se ajusta sola a cada fila."
  - key: exito
    order: 1
    mood: 1
    text: "Historia completa: 44 meses de venta facturada, sin proyecciones y un
      SKU por fila. Sobre esta tabla vamos a construir todo el pron\xF3stico."
  - key: consulta-incorrecta
    order: 1
    mood: 3
    text: "Todav\xEDa no me sirve: la tabla no es la que pidi\xF3 Sof\xEDa. Debe
      tener solo los SKU que pidi\xF3, los meses de ene-23 a ago-26 y ninguna columna
      de proyecci\xF3n. Arriba te dej\xE9 qu\xE9 falta."
  - key: totales-incorrectos
    order: 1
    mood: 3
    text: "Los totales de 12 meses no cuadran. Cada uno es la suma de sep-25 a ago-26
      (columnas AI a AT) de su fila. Arriba te dej\xE9 cu\xE1les fallan y cu\xE1nto
      deber\xEDan dar."
