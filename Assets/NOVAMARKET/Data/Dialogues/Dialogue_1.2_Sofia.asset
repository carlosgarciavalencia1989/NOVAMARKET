MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 257ba41e073b10a4cbe266f99f49a89e, type: 3}
  m_Name: Dialogue_1.2_Sofia
  m_EditorClassIdentifier: NovaMarket.Runtime::NovaMarket.Data.DialogueData
  id: 1.2-sofia
  displayName: "Nivel 1.2 \xB7 Sof\xEDa"
  description: "Sof\xEDa en el nivel 1.2 Limpiar los datos (entrega la facturaci\xF3n
    con problemas y da pistas gratis)."
  character: {fileID: 11400000, guid: da3215f2a4d1fd2438f92c338a0fe2de, type: 2}
  levelId: 1.2
  roleId: planeador
  sectorId: 
  lines:
  - key: intro
    order: 1
    mood: 2
    text: "Te pas\xE9 la facturaci\xF3n de {skus} SKU, pero viene con problemas:
      meses en cero que no son reales, un pedido raro de un cliente, meses antes
      de que un producto saliera a la venta y un SKU que no viene en unidades. Rev\xEDsala
      antes de que Andr\xE9s la use."
  - key: pista-FalseZero
    order: 1
    mood: 0
    text: "Un mes en cero en medio de meses con venta casi nunca es real: fue un
      agotado o un error al registrar. Si es un mes fuerte para ese SKU (su temporada),
      reempl\xE1zalo por el promedio del mismo mes en los otros a\xF1os."
  - key: pista-OneOffOrder
    order: 1
    mood: 0
    text: "Si un mes se dispara, abre en el ERP el detalle de facturas de ese mes
      (clic en la cifra): ah\xED ves qu\xE9 cliente compr\xF3 y si fue un pedido
      que no se va a repetir."
  - key: pista-PreLaunch
    order: 1
    mood: 0
    text: "Si un SKU empieza con varios meses en cero, revisa cu\xE1ndo sali\xF3
      a la venta. Los meses antes del lanzamiento no son demanda: se dejan vac\xEDos
      (Excluir), no en cero."
  - key: pista-UnitsInBoxes
    order: 1
    mood: 0
    text: "Revisa la unidad de empaque en el Maestro de materiales. Si un SKU se
      factura en cajas (CJ) y los dem\xE1s en unidades (UN), multiplica cada mes
      por sus unidades por caja para que toda la tabla quede en unidades."
