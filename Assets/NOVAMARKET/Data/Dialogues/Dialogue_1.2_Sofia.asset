MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 257ba41e073b10a4cbe266f99f49a89e, type: 3}
  m_Name: Dialogue_1.2_Sofia
  m_EditorClassIdentifier: NovaMarket.Runtime::NovaMarket.Data.DialogueData
  id: 1.2-sofia
  displayName: "Nivel 1.2 \xB7 Sof\xEDa"
  description: "Sof\xEDa en el nivel 1.2 Limpiar los datos (entrega la facturaci\xF3n
    con problemas y da pistas gratis)."
  character: {fileID: 11400000, guid: da3215f2a4d1fd2438f92c338a0fe2de, type: 2}
  levelId: 1.2
  roleId: planeador
  sectorId: 
  lines:
  - key: intro
    order: 1
    mood: 2
    text: "Te pas\xE9 la facturaci\xF3n de {skus} SKU, pero viene con problemas:
      ceros que no son reales, un pedido raro de un cliente, meses antes de un lanzamiento
      y algo raro con las unidades. Rev\xEDsala antes de que Andr\xE9s la use."
  - key: pista-FalseZero
    order: 1
    mood: 0
    text: "Un cero aislado entre meses con venta casi siempre es un agotado o un
      error de registro. Si el mes es fuerte para el SKU, imputa con el mismo mes
      de los otros a\xF1os."
  - key: pista-OneOffOrder
    order: 1
    mood: 0
    text: "Si un mes se dispara, abre el detalle de facturas de ese mes en el ERP:
      ah\xED ves qu\xE9 cliente lo compr\xF3 y por qu\xE9."
  - key: pista-PreLaunch
    order: 1
    mood: 0
    text: "Cuando un SKU arranca con puros ceros, revisa si ya exist\xEDa. Los meses
      antes del lanzamiento no son demanda: se excluyen."
  - key: pista-UnitsInBoxes
    order: 1
    mood: 0
    text: "Mira la columna UM. Si un SKU dice CJ y los dem\xE1s UN, est\xE1 en cajas.
      El maestro de materiales dice cu\xE1ntas unidades trae cada caja."
