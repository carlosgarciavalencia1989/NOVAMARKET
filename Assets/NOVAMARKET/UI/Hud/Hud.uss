:root {
    --gold: rgb(184, 145, 63);
    --gold-light: rgb(230, 199, 122);
    --gold-bright: rgb(240, 213, 140);
    --gold-dark: rgb(110, 84, 38);
    --panel: rgba(22, 17, 12, 0.92);
    --panel-deep: rgb(14, 11, 8);
    --text: rgb(237, 227, 200);
    --text-bright: rgb(244, 236, 214);
    --text-dim: rgb(181, 169, 138);
    --green: rgb(143, 209, 106);
    --blue: rgb(111, 183, 224);
    --amber: rgb(232, 176, 74);
    --red: rgb(224, 90, 67);
}

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: url("project://database/Assets/NOVAMARKET/UI/Fonts/Oswald_SDF.asset");
    color: var(--text);
    font-size: 15px;
}

.hidden {
    display: none;
}

/* Dark panel with a bevelled gold frame. */
.panel {
    background-color: var(--panel);
    border-width: 2px;
    border-color: var(--gold);
    border-top-color: var(--gold-light);
    border-bottom-color: var(--gold-dark);
    border-radius: 4px;
    padding: 10px 14px;
}

.hud-icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
}

/* ---------------------------------------------------------------- top right */

.hud-top-right {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 410px;
}

.level-bar {
    align-items: center;
    padding: 6px 14px;
    margin-bottom: 6px;
    background-color: var(--panel-deep);
}

.level-label {
    font-size: 22px;
    color: var(--gold-bright);
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.objectives-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 6px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--gold-dark);
}

.counter-label {
    font-size: 17px;
    color: var(--text-bright);
}

.counter-value {
    font-size: 24px;
    color: var(--gold-bright);
}

.section-title {
    font-size: 12px;
    color: var(--gold);
    letter-spacing: 2px;
    margin-top: 6px;
    margin-bottom: 2px;
}

.objective-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
    margin-bottom: 2px;
}

.objective-box {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 8px;
    border-width: 1px;
    border-color: var(--gold);
    border-radius: 2px;
    background-color: rgba(0, 0, 0, 0.45);
}

.objective-box .hud-icon {
    width: 14px;
    height: 14px;
    color: var(--green);
}

.objective-text {
    flex-shrink: 1;
    flex-grow: 1;
    white-space: normal;
    font-size: 15px;
}

.objective-row--secondary .objective-text {
    font-size: 14px;
    color: var(--text-dim);
}

.objective-row--done .objective-text {
    color: rgb(130, 122, 102);
}

.objective-progress {
    margin-left: 6px;
    font-size: 14px;
    color: var(--gold-light);
}

.score-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: var(--gold-dark);
}

.score-row .hud-icon {
    color: rgb(95, 198, 232);
    margin-right: 8px;
}

.score-label {
    flex-grow: 1;
    font-size: 16px;
    color: var(--text-bright);
}

.score-value {
    font-size: 22px;
    color: var(--gold-bright);
}

/* ---------------------------------------------------------------- notifications */

.hud-notifications {
    position: absolute;
    left: 16px;
    top: 200px;
    width: 380px;
}

.toast {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    padding: 8px 12px;
    border-left-width: 5px;
    opacity: 1;
    translate: 0 0;
    transition-duration: 0.35s;
}

.toast--hidden {
    opacity: 0;
    translate: -60px 0;
}

.toast .hud-icon {
    margin-right: 10px;
}

.toast-text {
    flex-shrink: 1;
    white-space: normal;
    color: var(--text-bright);
}

.toast--info {
    border-left-color: var(--blue);
}

.toast--info .hud-icon {
    color: var(--blue);
}

.toast--success {
    border-left-color: var(--green);
}

.toast--success .hud-icon {
    color: var(--green);
}

.toast--warning {
    border-left-color: var(--amber);
}

.toast--warning .hud-icon {
    color: var(--amber);
}

.toast--critical {
    border-left-color: var(--red);
}

.toast--critical .hud-icon {
    color: var(--red);
}

/* ---------------------------------------------------------------- bottom left: selection */

.hud-bottom-left {
    position: absolute;
    left: 16px;
    bottom: 16px;
    width: 450px;
}

.selection-header {
    flex-direction: row;
    align-items: center;
}

.selection-icon-frame {
    width: 68px;
    height: 68px;
    padding: 8px;
    margin-right: 12px;
    border-width: 2px;
    border-color: var(--gold);
    border-top-color: var(--gold-light);
    border-bottom-color: var(--gold-dark);
    border-radius: 3px;
    background-color: var(--panel-deep);
}

.selection-icon-frame .hud-icon {
    flex-grow: 1;
    width: auto;
    height: auto;
    color: var(--gold-light);
}

.selection-titles {
    flex-shrink: 1;
}

.selection-name {
    font-size: 24px;
    color: var(--gold-bright);
}

.selection-subtitle {
    font-size: 14px;
    color: var(--text-dim);
}

.selection-description {
    margin-top: 6px;
    white-space: normal;
}

.selection-stats {
    margin-top: 8px;
    padding: 6px 8px;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.35);
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 1px;
    margin-bottom: 1px;
}

.stat-label {
    font-size: 14px;
    color: var(--text-dim);
}

.stat-value {
    color: var(--text-bright);
}

.selection-progress {
    margin-top: 8px;
}

.progress-label {
    font-size: 13px;
    color: var(--text-dim);
}

.progress-track {
    height: 12px;
    margin-top: 2px;
    border-width: 1px;
    border-color: var(--gold);
    border-radius: 2px;
    background-color: rgba(0, 0, 0, 0.5);
}

.progress-fill {
    width: 0;
    height: 100%;
    border-radius: 1px;
    background-color: var(--amber);
}

.progress-fill--done {
    background-color: var(--green);
}

.selection-orders {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
    margin-left: -3px;
}

.order-button {
    margin: 3px;
    padding: 6px 12px;
    border-width: 1px;
    border-color: var(--gold);
    border-radius: 3px;
    background-color: rgb(58, 44, 25);
    color: var(--gold-bright);
    font-size: 14px;
    transition-duration: 0.12s;
}

.order-button:hover {
    background-color: rgb(92, 69, 36);
    border-color: var(--gold-bright);
}

.order-button:active {
    background-color: rgb(36, 25, 14);
}

/* ---------------------------------------------------------------- bottom right: resources + minimap */

.hud-bottom-right {
    position: absolute;
    right: 16px;
    bottom: 16px;
    flex-direction: row;
    align-items: flex-end;
}

.resource-bar {
    flex-direction: row;
    margin-right: 10px;
    margin-bottom: 10px;
    padding: 6px 4px;
}

.resource {
    flex-direction: row;
    align-items: center;
    padding: 2px 12px;
    border-right-width: 1px;
    border-right-color: var(--gold-dark);
}

.resource--last {
    border-right-width: 0;
}

.resource .hud-icon {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    color: var(--gold-light);
}

.resource-caption {
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--text-dim);
}

.resource-value {
    font-size: 19px;
    color: var(--text-bright);
}

.resource--good .resource-value {
    color: var(--green);
}

.resource--alert .resource-value {
    color: var(--red);
}

.resource--alert .hud-icon {
    color: var(--red);
}

.minimap-frame {
    width: 240px;
    height: 240px;
    padding: 4px;
    border-width: 5px;
    border-color: var(--gold);
    border-top-color: var(--gold-light);
    border-bottom-color: var(--gold-dark);
    border-radius: 120px;
    background-color: var(--panel-deep);
}

.minimap {
    flex-grow: 1;
    overflow: hidden;
    border-radius: 111px;
    background-color: rgb(52, 58, 36);
    -unity-background-scale-mode: scale-and-crop;
}

.minimap-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.minimap-north {
    position: absolute;
    top: -14px;
    left: 50%;
    width: 24px;
    height: 24px;
    margin-left: -12px;
    border-width: 2px;
    border-color: var(--gold-light);
    border-radius: 12px;
    background-color: var(--panel-deep);
    color: var(--gold-bright);
    font-size: 13px;
    -unity-text-align: middle-center;
    padding: 0;
}
