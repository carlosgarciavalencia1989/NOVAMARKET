/* Planner sheet: feels like a spreadsheet (formula bar, A B C headers, row numbers, fill handle, tabs). */

:root {
    --sheet-green: rgb(30, 110, 66);
    --sheet-green-dark: rgb(22, 82, 50);
    --sheet-grid: rgb(214, 214, 214);
    --sheet-head: rgb(239, 239, 239);
    --sheet-head-line: rgb(196, 196, 196);
    --sheet-ink: rgb(26, 26, 26);
    --sheet-ink-dim: rgb(96, 96, 96);
}

.sheet-screen {
    flex-grow: 1;
    background-color: rgb(255, 255, 255);
    color: var(--sheet-ink);
}

.sheet-titlebar {
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding: 0 14px;
    background-color: var(--sheet-green);
}

.sheet-titlebar .hud-icon {
    width: 28px;
    height: 28px;
    margin-right: 10px;
    color: rgb(255, 255, 255);
}

.sheet-title {
    font-size: 23px;
    color: rgb(255, 255, 255);
}

.sheet-file {
    margin-left: 14px;
    font-size: 16px;
    color: rgb(200, 232, 212);
}

.sheet-titlebar-spacer {
    flex-grow: 1;
}

.sheet-close {
    margin: 0;
    padding: 6px 16px;
    border-width: 1px;
    border-color: rgb(140, 200, 164);
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.1);
    color: rgb(255, 255, 255);
    font-size: 16px;
}

.sheet-close:hover {
    background-color: rgba(255, 255, 255, 0.24);
}

/* ---------------------------------------------------------------- toolbar and formula bar */

.sheet-toolbar {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding: 0 10px;
    background-color: rgb(246, 246, 246);
    border-bottom-width: 1px;
    border-bottom-color: var(--sheet-head-line);
}

.sheet-tool {
    margin: 0 4px 0 0;
    padding: 4px 12px;
    border-width: 1px;
    border-color: rgb(200, 200, 200);
    border-radius: 3px;
    background-color: rgb(255, 255, 255);
    color: var(--sheet-ink);
    font-size: 16px;
}

.sheet-tool:hover {
    background-color: rgb(226, 240, 230);
    border-color: var(--sheet-green);
}

.sheet-tool-separator {
    width: 1px;
    height: 26px;
    margin: 0 10px;
    background-color: rgb(200, 200, 200);
}

.sheet-functions {
    flex-grow: 1;
    font-size: 15px;
    color: var(--sheet-ink-dim);
    -unity-text-align: middle-right;
}

.formula-bar {
    flex-direction: row;
    align-items: center;
    height: 42px;
    padding: 0 8px;
    background-color: rgb(255, 255, 255);
    border-bottom-width: 1px;
    border-bottom-color: var(--sheet-head-line);
}

.name-box {
    width: 110px;
    height: 30px;
    padding: 0 8px;
    border-width: 1px;
    border-color: rgb(190, 190, 190);
    font-size: 18px;
    color: var(--sheet-ink);
    -unity-text-align: middle-left;
}

.fx-label {
    width: 44px;
    font-size: 20px;
    color: var(--sheet-ink-dim);
    -unity-text-align: middle-center;
    -unity-font-style: italic;
}

.formula-field {
    flex-grow: 1;
    margin: 0;
}

.formula-field .unity-base-field__input,
.cell-editor .unity-base-field__input {
    padding: 0 6px;
    border-width: 1px;
    border-color: rgb(190, 190, 190);
    border-radius: 0;
    background-color: rgb(255, 255, 255);
}

.formula-field .unity-base-field__input {
    min-height: 30px;
}

.formula-field .unity-text-element,
.cell-editor .unity-text-element {
    font-size: 18px;
    color: var(--sheet-ink);
}

/* ---------------------------------------------------------------- grid */

.sheet-grid {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    background-color: rgb(255, 255, 255);
}

.sheet-cells {
    position: absolute;
    overflow: hidden;
}

.sheet-cell {
    position: absolute;
    padding: 0 6px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--sheet-grid);
    font-size: 17px;
    color: var(--sheet-ink);
    -unity-text-align: middle-left;
    overflow: hidden;
    white-space: nowrap;
}

.sheet-cell--number {
    -unity-text-align: middle-right;
}

.sheet-cell--center {
    -unity-text-align: middle-center;
}

.sheet-cell--error {
    color: rgb(192, 0, 0);
    -unity-text-align: middle-center;
}

.sheet-cell--overflow {
    border-right-width: 0;
}

.sheet-cell--header-row {
    -unity-font-style: bold;
    background-color: rgb(248, 248, 244);
}

.sheet-head-strip {
    position: absolute;
    overflow: hidden;
    background-color: var(--sheet-head);
}

.sheet-head {
    position: absolute;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--sheet-head-line);
    font-size: 15px;
    color: rgb(70, 70, 70);
    -unity-text-align: middle-center;
    padding: 0;
}

.sheet-head--active {
    background-color: rgb(210, 230, 216);
    color: var(--sheet-green-dark);
    border-bottom-color: var(--sheet-green);
}

.sheet-corner {
    position: absolute;
    left: 0;
    top: 0;
    background-color: var(--sheet-head);
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--sheet-head-line);
}

.sheet-range {
    position: absolute;
    background-color: rgba(30, 110, 66, 0.12);
    border-width: 1px;
    border-color: var(--sheet-green);
}

.sheet-active {
    position: absolute;
    border-width: 2px;
    border-color: var(--sheet-green);
}

.sheet-fill-target {
    position: absolute;
    border-width: 2px;
    border-color: rgb(120, 120, 120);
}

.fill-handle {
    position: absolute;
    width: 9px;
    height: 9px;
    border-width: 1px;
    border-color: rgb(255, 255, 255);
    background-color: var(--sheet-green);
}

.cell-editor {
    position: absolute;
    margin: 0;
}

.cell-editor .unity-base-field__input {
    border-width: 2px;
    border-color: var(--sheet-green);
}

.sheet-scroller {
    position: absolute;
}

/* ---------------------------------------------------------------- tabs and status */

.sheet-tabs {
    flex-direction: row;
    align-items: flex-end;
    height: 38px;
    padding: 0 8px;
    background-color: rgb(236, 236, 236);
    border-top-width: 1px;
    border-top-color: var(--sheet-head-line);
}

.sheet-tab {
    margin: 0 2px 0 0;
    padding: 5px 18px;
    border-width: 1px;
    border-top-width: 0;
    border-color: rgb(200, 200, 200);
    border-radius: 0 0 4px 4px;
    background-color: rgb(226, 226, 226);
    color: rgb(60, 60, 60);
    font-size: 16px;
}

.sheet-tab:hover {
    background-color: rgb(244, 244, 244);
}

.sheet-tab--active,
.sheet-tab--active:hover {
    background-color: rgb(255, 255, 255);
    border-bottom-width: 3px;
    border-bottom-color: var(--sheet-green);
    color: var(--sheet-green-dark);
}

.sheet-empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 38%;
    font-size: 20px;
    color: var(--sheet-ink-dim);
    -unity-text-align: middle-center;
    white-space: normal;
}

.sheet-status {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding: 0 14px;
    background-color: var(--sheet-green-dark);
}

.sheet-status-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 15px;
    color: rgb(232, 244, 236);
    overflow: hidden;
}

.sheet-status--error .sheet-status-text {
    color: rgb(255, 214, 196);
}

.sheet-status-stats {
    font-size: 15px;
    color: rgb(232, 244, 236);
}

.sheet-screen Label {
    margin-top: 0;
    margin-bottom: 0;
}
